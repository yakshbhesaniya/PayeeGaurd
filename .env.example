CRUSTDATA_API_KEY=
# 64 hex chars; generate with: openssl rand -hex 32
PAYEEGUARD_FP_SECRET=
# 1 = cache only (demo / no Wi-Fi)
PAYEEGUARD_OFFLINE=0
# text | json
PAYEEGUARD_LOG=text
PAYEEGUARD_CACHE_DIR=.cache
PAYEEGUARD_DATA_DIR=data
# 1 = create real Crustdata watchers when a payment is released (off by default for demos)
PAYEEGUARD_WATCHERS=0

# ---- Live integrations (optional; each switches on when filled) ----
# Real inbox: watch a mailbox for new invoices (Gmail: imap.gmail.com + an App Password)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Real email sending (Gmail: smtp.gmail.com, port 465, same App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Safety: every email goes here instead of the real vendor unless EMAIL_TO_VENDOR=1
SAFE_RECIPIENT=
EMAIL_TO_VENDOR=0
# Payment gateway in TEST mode only (live keys are refused): Stripe sk_test_... or Razorpay rzp_test_...
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Juspay SANDBOX (host must contain 'sandbox'; docs list sandbox.juspay.in or payments.sandbox.juspay.in)
JUSPAY_API_KEY=
JUSPAY_MERCHANT_ID=
JUSPAY_BASE_URL=https://sandbox.juspay.in
# Slack or Microsoft Teams incoming webhook for HOLD/BLOCK alerts
ALERT_WEBHOOK_URL=
